# ============================================================
# Configuracion del proyecto — copia este archivo a .env y completa
# ============================================================

# --- Django ---
# Genera con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=cambia-esto-por-una-clave-segura-generada

# True en desarrollo, False en produccion
DEBUG=True

# Lista separada por comas
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Email ---
# Para desarrollo: deja el backend por consola (los correos se imprimen en la terminal)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Para envio real con Gmail descomenta y completa lo siguiente
# (necesitas un App Password: https://support.google.com/accounts/answer/185833)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=tucorreo@gmail.com
# EMAIL_HOST_PASSWORD=tu_app_password_de_gmail
# DEFAULT_FROM_EMAIL=Sistema de Reservas IME <tucorreo@gmail.com>

# --- Cloudinary (almacenamiento de imagenes subidas) ---
# Opcional: si se dejan vacias, las imagenes se guardan en el disco local.
# Credenciales en https://cloudinary.com/console despues de crear la cuenta.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- Despliegue automatico (webhook de GitHub) ---
# Solo se necesita en el servidor (PythonAnywhere), no en desarrollo local.
# Genera un valor aleatorio largo y usalo tambien como "Secret" del webhook en GitHub.
# GITHUB_WEBHOOK_SECRET=

# Token de API de PythonAnywhere (Account > API Token) y tu usuario ahi.
# Se usa para pedirle a PythonAnywhere que recargue la app despues de cada
# push (el proceso de la app no puede tocar sus propios archivos de config).
# PYTHONANYWHERE_API_TOKEN=
# PYTHONANYWHERE_USERNAME=
